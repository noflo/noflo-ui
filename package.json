{
  "name": "noflo-ui",
  "version": "1.0.0",
  "description": "",
  "license": "EUPL-1.2",
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "npx @biomejs/biome check src/ spec/ index.html",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write src/ spec/ index.html",
    "types": "npx tsc --checkJs --noEmit --allowJs --skipLibCheck --ignoreConfig src/*.js src/**/*.js src/*.d.ts",
    "generate:fa": "node utils/generate-icon-map.js",
    "prebuild-vendors": "npm run generate:fa && npm run generate:vendor-types",
    "generate:vendor-types": "node utils/generate-vendor-types.js",
    "build-vendors": "node utils/build-vendors.js",
    "test": "node --test --test-force-exit --test-timeout 5000 spec/**/*.js"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@noble/curves": "^2.4.0",
    "@noflo/core": "2.0.0-alpha.1",
    "@noflo/noflo": "2.0.0-alpha.2",
    "@reticulum/core": "^0.9.6",
    "@reticulum/dacar": "^1.5.0",
    "@reticulum/lxmf": "^0.9.7",
    "@reticulum/websocket-server-node": "^0.9.7",
    "codemirror": "^6.0.2",
    "eventemitter3": "^5.0.4",
    "jedison": "^1.13.0",
    "qrcode": "^1.5.4",
    "source-code-pro": "^2.42.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-reticulum": "^0.5.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.10.6",
    "js-yaml": "^5.1.0",
    "typescript": "^6.0.3"
  },
  "esinstall": {
    "install": [
      "noflo"
    ],
    "installOptions": {
      "dest": "vendor",
      "polyfillNode": true
    }
  },
  "copyVendors": {
    "wgpu-matrix": "dist/3.x/wgpu-matrix.module.js"
  },
  "imports": {
    "#interfaces": "./src/node/interfaces.js"
  },
  "bin": {
    "noflo-ui": "src/node/bridge.js"
  }
}
