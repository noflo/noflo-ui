{
  "name": "flow-editor",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "npx @biomejs/biome check src/ spec/ index.html",
    "format": "npx @biomejs/biome check --write src/ spec/ index.html",
    "prebuild-vendors": "node utils/generate-noflo-loader.js",
    "build-vendors": " tsdown --config tsdown.config.js",
    "postbuild-vendors": "cp node_modules/source-code-pro/WOFF2/OTF/SourceCodePro-Regular.otf.woff2 vendor/SourceCodePro-Regular.otf.woff2",
    "test": "node --test spec/elements/*.js",
    "serve": "npx serve -l 3000 ."
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "noflo": "^1.5.2",
    "noflo-core": "^0.6.1",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "noflo-component-loader": "^0.4.1",
    "source-code-pro": "^2.42.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "esinstall": {
    "install": [
      "noflo"
    ],
    "installOptions": {
      "dest": "vendor",
      "polyfillNode": true
    }
  },
  "copyVendors": {
    "wgpu-matrix": "dist/3.x/wgpu-matrix.module.js"
  }
}
