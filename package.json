{
  "name": "noflo-ui",
  "version": "1.0.0",
  "description": "",
  "license": "EUPL-1.2",
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "npx @biomejs/biome check src/ spec/ index.html",
    "format": "npx @biomejs/biome check --write src/ spec/ index.html",
    "types": "npx tsc --checkJs --noEmit --allowJs --declaration src/*.js src/**/*.js",
    "generate:noflo": "node utils/generate-noflo-loader.js",
    "generate:fa": "node utils/generate-icon-map.js",
    "prebuild-vendors": "npm run generate:noflo && npm run generate:fa",
    "build-vendors": " tsdown --config tsdown.config.js",
    "test": "node --test --test-force-exit --test-timeout 5000 spec/**/*.js",
    "serve": "npx serve -l 3000 ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "eventemitter3": "^5.0.4",
    "jedison": "^1.13.0",
    "noflo": "^1.5.2",
    "noflo-core": "^0.6.1",
    "source-code-pro": "^2.42.0"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "js-yaml": "^5.1.0",
    "noflo-component-loader": "^0.4.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "esinstall": {
    "install": [
      "noflo"
    ],
    "installOptions": {
      "dest": "vendor",
      "polyfillNode": true
    }
  },
  "copyVendors": {
    "wgpu-matrix": "dist/3.x/wgpu-matrix.module.js"
  }
}
