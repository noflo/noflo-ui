{
  "name": "noflo-ui",
  "version": "1.0.0",
  "description": "",
  "license": "EUPL-1.2",
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "npx @biomejs/biome check src/ spec/ index.html",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write src/ spec/ index.html",
    "types": "npx tsc --checkJs --noEmit --allowJs --skipLibCheck --ignoreConfig src/*.js src/**/*.js",
    "generate:noflo": "node utils/generate-noflo-loader.js",
    "generate:fa": "node utils/generate-icon-map.js",
    "prebuild-vendors": "npm run generate:noflo && npm run generate:fa && npm run generate:vendor-types",
    "generate:vendor-types": "node utils/generate-vendor-types.js",
    "build-vendors": " tsdown --config tsdown.config.js",
    "test": "node --test --test-force-exit --test-timeout 5000 spec/**/*.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@noble/curves": "^2.4.0",
    "@reticulum/core": "^0.9.6",
    "@reticulum/dacar": "^1.5.0",
    "@reticulum/lxmf": "^0.9.7",
    "@reticulum/websocket-server-node": "^0.9.7",
    "eventemitter3": "^5.0.4",
    "jedison": "^1.13.0",
    "noflo": "^1.5.2",
    "noflo-core": "^0.6.1",
    "qrcode": "^1.5.4",
    "source-code-pro": "^2.42.0",
    "y-indexeddb": "^9.0.12",
    "y-reticulum": "^0.4.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "js-yaml": "^5.1.0",
    "noflo-component-loader": "^0.4.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "esinstall": {
    "install": [
      "noflo"
    ],
    "installOptions": {
      "dest": "vendor",
      "polyfillNode": true
    }
  },
  "copyVendors": {
    "wgpu-matrix": "dist/3.x/wgpu-matrix.module.js"
  },
  "imports": {
    "#interfaces": "./src/node/interfaces.js"
  },
  "bin": {
    "noflo-ui": "src/node/bridge.js"
  }
}
